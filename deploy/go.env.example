# Copy to .env.go and chmod 600. Use URL-safe letters, digits, _ and - in passwords.
CHATGPT2API_GO_PROJECT=chatgpt2api-go
CHATGPT2API_GO_IMAGE=ghcr.io/heiyuan0801/chatgpt2api-go:v3.2.3-go.1
CHATGPT2API_RELEASE_REPOSITORY=heiyuan0801/chat2api
CHATGPT2API_GO_BIND=127.0.0.1
CHATGPT2API_GO_PORT=3001
CHATGPT2API_AUTH_KEY=replace_with_private_bootstrap_key
POSTGRES_DB=chatgpt2api
POSTGRES_USER=chatgpt2api
POSTGRES_PASSWORD=replace_with_private_postgres_password
REDIS_PASSWORD=replace_with_private_redis_password
CHATGPT2API_REDIS_NAMESPACE=chatgpt2api-go
# Set the public origin before enabling canary traffic.
# CHATGPT2API_BASE_URL=https://your-domain.example
TZ=Asia/Shanghai
